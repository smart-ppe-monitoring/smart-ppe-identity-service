PORT=9999
NODE_ENV=development

# Database connection (ppe_identity_db)
IDENTITY_DATABASE_URL="postgresql://ppe_identity_user:ppe_identity_dev_pass@localhost:5433/ppe_identity_db?schema=public"

# Redis (Cache, Sessions, Rate Limiting, Outbox Relay)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true

# JWT Secrets & Asymmetric Keys
JWT_ACCESS_PRIVATE_KEY_PATH="./keys/private.key.pem"
JWT_ACCESS_PUBLIC_KEY_PATH="./keys/public.key.pem"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER="smart-ppe-identity-service"
JWT_AUDIENCE="smart-ppe-monitoring"

# Turnstile Cloudflare Captcha
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ENABLED=false

# System Config
SYSTEM_MAINTENANCE_MODE=false
GATEWAY_INTERNAL_SECRET=dev_internal_gateway_secret_2026
