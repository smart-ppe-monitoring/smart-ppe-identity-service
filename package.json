{
  "name": "smart-ppe-identity-service",
  "version": "1.0.0",
  "description": "PPE Identity & Access Management Microservice (:9999) - Auth, Users, RBAC, JWKS RFC 7517, TOTP 2FA",
  "main": "dist/server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smart-ppe-monitoring/smart-ppe-identity-service.git"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:identity": "ts-node-dev --respawn --transpile-only src/identity.server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:identity": "node dist/identity.server.js",
    "start:worker": "node dist/worker.server.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node --test --test-concurrency=1 --import tsx tests/*.test.ts"
  },
  "dependencies": {
    "@smart-ppe/common": "git+https://github.com/smart-ppe-monitoring/smart-ppe-shared-contracts.git",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "swagger-ui-express": "^5.0.1",
    "uuidv7": "^1.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.0",
    "@types/nodemailer": "^8.0.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
